# Local workspaces: installed environments, bundles, models and evaluation runs.
# Matches work/ at any depth, including modularize-demo/work/.
work/

# Python environments and generated packaging files.
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
*.egg
build/
dist/
.eggs/

# Test, type-checker and tool caches.
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml
.ipynb_checkpoints/

# Local secrets. Keep sanitized example/template environment files shareable.
.env
.env.*
*.env
!.env.example
!.env.sample
!.env.template
!.env.*.example
!.env.*.sample
!.env.*.template
credentials.json
credentials.*.json
*-credentials.json
worker-token.json
*.pem
*.key
id_rsa
id_ed25519

# Runtime files and local databases.
*.log
*.pid
*.pid.lock
*.sock
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
*.sqlite3-wal
*.sqlite3-shm

# Editor and operating-system files.
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
._*
Thumbs.db
Desktop.ini

# Source, configs, assets, docs, evidence indexes and .agents/skills/ are tracked.
# Do not ignore all *.json, *.yaml or *.lock files: they can be project inputs.
